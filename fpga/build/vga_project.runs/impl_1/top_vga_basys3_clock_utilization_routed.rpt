# Location of BUFG Primitives 
set_property LOC BUFGCTRL_X0Y0 [get_cells clk_out_bufgce]

# Location of BUFH Primitives 
set_property LOC BUFHCE_X0Y0 [get_cells clk_out_bufh]

# Location of IO Primitives which is load of clock spine

# Location of clock ports
set_property LOC IOB_X1Y26 [get_ports clk]

# Clock net "pclk" driven by instance "clk_out_bufgce" located at site "BUFGCTRL_X0Y0"
#startgroup
create_pblock {CLKAG_pclk}
add_cells_to_pblock [get_pblocks  {CLKAG_pclk}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="pclk"}]]]
resize_pblock [get_pblocks {CLKAG_pclk}] -add {CLOCKREGION_X0Y0:CLOCKREGION_X0Y0 CLOCKREGION_X1Y1:CLOCKREGION_X1Y1}
#endgroup

# Clock net "clk_ss" driven by instance "clk_out_bufh" located at site "BUFHCE_X0Y0"
#startgroup
create_pblock {CLKAG_clk_ss}
add_cells_to_pblock [get_pblocks  {CLKAG_clk_ss}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="clk_ss"}]]]
resize_pblock [get_pblocks {CLKAG_clk_ss}] -add {CLOCKREGION_X0Y0:CLOCKREGION_X0Y0}
#endgroup
